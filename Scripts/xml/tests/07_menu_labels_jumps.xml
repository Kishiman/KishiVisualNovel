<?xml version='1.0' encoding='utf-8'?>
<visualNovel version="1">
  <character name="s" displayName="Sylvie" color="#c8ffc8" />
  <character name="m" displayName="Me" color="#c8c8ff" />
  <label name="start">
    <say character="s">Sure, but what's a "visual novel?"</say>
    <menu>
      <choice text="It's a videogame.">
        <jump label="game" />
      </choice>
      <choice text="It's an interactive book.">
        <jump label="book" />
      </choice>
    </menu>
  </label>
  <label name="game">
    <say character="m">It's a kind of videogame you can play on your computer or a console.</say>
    <jump label="marry" />
  </label>
  <label name="book">
    <say character="m">It's like an interactive book that you can read on a computer or a console.</say>
    <jump label="marry" />
  </label>
  <label name="marry">
    <say character="m">will you marry me?</say>
    <menu>
      <choice text="Yes">
        <say character="s">Consent!</say>
      </choice>
      <choice text="No">
        <say character="s">Objection!</say>
      </choice>
    </menu>
    <say>And so, we become a visual novel creating duo.</say>
  </label>
</visualNovel>
