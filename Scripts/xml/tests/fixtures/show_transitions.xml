<?xml version="1.0" encoding="utf-8"?>
<visualNovel version="1">
  <!-- show / hide: every built-in transition name.
       Expected: each line names the transition that just played, so the dialogue and the
       animation must agree. Each transition finishes before the next command starts, so a
       line appears only once its sprite has arrived. The named directions are the four
       suffixes of "easein" and "movein"; they slide in an image that is entering, so each
       directional show follows a hide. A transition that does nothing, or a
       "Could Not Found Default Transition" error in the log, is a failure. -->
  <label name="start">
    <scene asset="bg_meadow" />

    <show asset="sylvie" attributes="green normal" transition="fade" duration="0.5" />
    <say>fade in</say>
    <hide tag="sylvie" transition="fade" duration="0.5" />
    <say>fade out</say>

    <show asset="sylvie" attributes="green smile" transition="dissolve" duration="0.5" />
    <say>dissolve in</say>
    <hide tag="sylvie" transition="dissolve" duration="0.5" />
    <say>dissolve out</say>

    <show asset="sylvie" attributes="green giggle" transition="zoom" duration="0.5" />
    <say>zoom (also accepted as zoomin)</say>
    <hide tag="sylvie" transition="zoom" duration="0.5" />
    <say>zoom out</say>

    <show asset="sylvie" attributes="green normal" transition="blur" duration="0.5" />
    <say>blur</say>
    <show asset="sylvie" attributes="green surprised" transition="shake" duration="0.5" />
    <say>shake</say>
    <show asset="sylvie" attributes="green smile" transition="wipe" duration="0.5" />
    <say>wipe</say>
    <hide tag="sylvie" transition="fade" duration="0.5" />

    <show asset="sylvie" attributes="green normal" transition="easeinleft" duration="0.5" />
    <say>easeinleft</say>
    <hide tag="sylvie" />
    <show asset="sylvie" attributes="green normal" transition="easeinright" duration="0.5" />
    <say>easeinright</say>
    <hide tag="sylvie" />
    <show asset="sylvie" attributes="green normal" transition="easeintop" duration="0.5" />
    <say>easeintop (also accepted as easeinup)</say>
    <hide tag="sylvie" />
    <show asset="sylvie" attributes="green normal" transition="easeinbottom" duration="0.5" />
    <say>easeinbottom (also accepted as easeindown)</say>
    <hide tag="sylvie" transition="easeinleft" duration="0.5" />
    <say>easeinleft on hide</say>

    <show asset="sylvie" attributes="green smile" transition="moveinleft" duration="0.5" />
    <say>moveinleft</say>
    <hide tag="sylvie" />
    <show asset="sylvie" attributes="green smile" transition="moveinright" duration="0.5" />
    <say>moveinright</say>
    <hide tag="sylvie" />
    <show asset="sylvie" attributes="green smile" transition="moveintop" duration="0.5" />
    <say>moveintop</say>
    <hide tag="sylvie" />
    <show asset="sylvie" attributes="green smile" transition="moveinbottom" duration="0.5" />
    <say>moveinbottom</say>
    <hide tag="sylvie" transition="moveinbottom" duration="0.5" />
    <say>moveinbottom on hide</say>
    <return />
  </label>
</visualNovel>
