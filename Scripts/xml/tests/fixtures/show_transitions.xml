<?xml version="1.0" encoding="utf-8"?>
<visualNovel version="1">
  <!-- show / hide: every built-in transition name.
       Expected: each line names the transition that just played, so the dialogue and the
       animation must agree. Each transition finishes before the next command starts, so a
       line appears only once its sprite has arrived. The named directions are the four
       suffixes of "ease" and "move"; they slide in an image that is entering, so each
       directional show follows a hide. A transition that does nothing, or a
       "Could Not Found Default Transition" error in the log, is a failure. -->
  <label name="start">
    <scene asset="bg_meadow" />

    <show asset="sylvie" attributes="green normal" transition="fade" duration="0.5" />
    <say>fade in</say>
    <hide tag="sylvie" transition="fade" duration="0.5" />
    <say>fade out</say>

    <show asset="sylvie" attributes="green giggle" transition="zoom" duration="0.5" />
    <say>zoom on show</say>
    <hide tag="sylvie" transition="zoom" duration="0.5" />
    <say>zoom on hide: one name plays the transition in both directions.</say>

    <show asset="sylvie" attributes="green normal" transition="blur" duration="0.5" />
    <say>blur</say>
    <show asset="sylvie" attributes="green surprised" transition="shake" duration="0.5" />
    <say>shake</say>
    <show asset="sylvie" attributes="green smile" transition="wipe" duration="0.5" />
    <say>wipe</say>
    <hide tag="sylvie" transition="fade" duration="0.5" />

    <show asset="sylvie" attributes="green normal" transition="easeleft" duration="0.5" />
    <say>easeleft</say>
    <hide tag="sylvie" />
    <show asset="sylvie" attributes="green normal" transition="easeright" duration="0.5" />
    <say>easeright</say>
    <hide tag="sylvie" />
    <show asset="sylvie" attributes="green normal" transition="easetop" duration="0.5" />
    <say>easetop (also accepted as easeup)</say>
    <hide tag="sylvie" />
    <show asset="sylvie" attributes="green normal" transition="easebottom" duration="0.5" />
    <say>easebottom (also accepted as easedown)</say>
    <hide tag="sylvie" transition="easeleft" duration="0.5" />
    <say>easeleft on hide</say>

    <show asset="sylvie" attributes="green smile" transition="moveleft" duration="0.5" />
    <say>moveleft</say>
    <hide tag="sylvie" />
    <show asset="sylvie" attributes="green smile" transition="moveright" duration="0.5" />
    <say>moveright</say>
    <hide tag="sylvie" />
    <show asset="sylvie" attributes="green smile" transition="movetop" duration="0.5" />
    <say>movetop</say>
    <hide tag="sylvie" />
    <show asset="sylvie" attributes="green smile" transition="movebottom" duration="0.5" />
    <say>movebottom</say>
    <hide tag="sylvie" transition="movebottom" duration="0.5" />
    <say>movebottom on hide</say>
    <return />
  </label>
</visualNovel>
