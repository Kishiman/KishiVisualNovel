<?xml version='1.0' encoding='utf-8'?>
<visualNovel version="1">
  <!-- scene: a level sequence as the transition, on named anchor layers.
       Expected: the declared "intro" transition resolves to the trial_intro sequence and
       plays with the active camera bound to it. Each "layer" attribute names the anchor the
       camera attaches to, found by the camera anchor interface first and by actor tag
       second, so this fixture needs a level with student1, student2 and student3 anchors
       (Maps/demo_danganronpa). A missing anchor must log and continue. -->
  <character name="aug" displayName="Augustina" color="#c8ffc8" />
  <asset kind="transition" name="intro" path="trial_intro" />
  <asset kind="image" name="Augustina" path="Augustina" />
  <label name="start">
    <scene asset="_" transition="intro" />
    <show asset="Augustina" attributes="dress smile" transition="fade" />
    <say character="aug">...................... I like this <red>dress</red>.</say>
    <scene asset="_" layer="student1" />
    <show asset="Augustina" attributes="swimsuit tongue sweat" />
    <say character="aug">But what I like even more...</say>
    <scene asset="_" layer="student2" />
    <show asset="Augustina" attributes="swimsuit unsure blush half up" />
    <say character="aug">Augustina swimsuit unsure blush half up</say>
    <show asset="Augustina" attributes="swimsuit unsure blush half oneup" />
    <say character="aug">Augustina dress unsure blush half oneup</say>
    <scene asset="_" transition="intro" layer="student3" />
    <show asset="Augustina" attributes="jeans surprise" transition="fade" duration="5.0" />
    <say character="aug">Is this <blue>jeans! ... <red>SO COOL RIGHT?</red> ... don't laugh</blue>!</say>
    <show asset="Augustina" attributes="jeans drool bigblush cry" />
    <say character="aug">don't <red>laugh</red>!... please...</say>
  </label>
</visualNovel>