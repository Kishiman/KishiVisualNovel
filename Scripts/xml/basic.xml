<?xml version='1.0' encoding='utf-8'?>
<visualNovel version="1">
  <set name="variable_name" value="Hello, world!" />
  <set name="number_variable" value="10" />
  <if condition="number_variable &gt; 5">
    <set name="variable_name" value="Number variable is greater than 5!" />
  </if>
  <set name="loop_variable" value="0" />
  <raw source="while loop_variable &lt; 10:">
    <raw source="$ loop_variable += 1" />
    <say>Loop variable is now $loop_variable</say>
  </raw>
  <raw source="define my_function():">
    <say>This is a function.</say>
  </raw>
  <raw source="my_function()" />
  <label name="start">
    <say>This is some text.</say>
    <say>This is more text.</say>
    <say>This is text on a new line.
      This is more text on the same line.</say>
  </label>
  <say character="image">background.png</say>
  <show asset="character" attributes="character.png" />
  <play channel="music" asset="music.mp3" />
  <play channel="sound" asset="sound.wav" />
  <raw source="with dissolve:">
    <say>This text will dissolve in and out.</say>
  </raw>
  <menu>
    <say>Choose an option.</say>
    <choice text="Option 1">
      <say>You chose option 1.</say>
    </choice>
    <choice text="Option 2">
      <say>You chose option 2.</say>
    </choice>
  </menu>
  <return />
</visualNovel>